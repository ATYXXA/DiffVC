    "import math \n",
    "beta_min = 0.05\n",
    "beta_max = 20.0\n",
    "def get_beta( t):\n",
    "    beta = beta_min + (beta_max - beta_min) * t\n",
    "    return beta\n",
    "\n",
    "def get_gamma( s, t, p=1.0, use_torch=False):\n",
    "    beta_integral = beta_min + 0.5*(beta_max - beta_min)*(t + s)\n",
    "    beta_integral *= (t - s)\n",
    "    if use_torch:\n",
    "        gamma = torch.exp(-0.5*p*beta_integral).unsqueeze(-1).unsqueeze(-1)\n",
    "    else:\n",
    "        gamma = math.exp(-0.5*p*beta_integral)\n",
    "    return gamma\n",
    "\n",
    "def get_mu(s, t):\n",
    "    a = get_gamma(s, t)\n",
    "    b = 1.0 - get_gamma(0, s, p=2.0)\n",
    "    c = 1.0 - get_gamma(0, t, p=2.0)\n",
    "    return a * b / c\n",
    "\n",
    "def get_nu( s, t):\n",
    "    a = get_gamma(0, s)\n",
    "    b = 1.0 - get_gamma(s, t, p=2.0)\n",
    "    c = 1.0 - get_gamma(0, t, p=2.0)\n",
    "    return a * b / c\n",
    "\n",
    "def get_sigma(s, t):\n",
    "    a = 1.0 - get_gamma(0, s, p=2.0)\n",
    "    b = 1.0 - get_gamma(s, t, p=2.0)\n",
    "    c = 1.0 - get_gamma(0, t, p=2.0)\n",
    "    return math.sqrt(a * b / c)"
