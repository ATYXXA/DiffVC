    "import os\n",
    "def clean_ckpts(dir,num_keep):\n",
    "    ckpts = [i for i in os.listdir('logs_dec') if i.endswith(\".pt\")]\n",
    "    def time_key(_f):\n",
    "        return os.path.getmtime(os.path.join(dir, _f))\n",
    "    todel = sorted(ckpts,key=time_key)[:-num_keep]\n",
    "    for ckpt in todel:\n",
    "        os.remove(os.path.join(dir,ckpt))\n",
    "        print(f\"free up space by deleting ckpt: {ckpt}\")\n",
    "\n",
    "clean_ckpts(dir='logs_dec',num_keep=5)"
   ]
  },
